# gemini | groq | openai | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: override the provider's default model
# LLM_MODEL=
# true = scripted replies, no API key needed (also automatic when the key above is empty)
DEMO_MODE=false
# Optional: seconds per scripted reply in demo mode (0 = instant)
# DEMO_DELAY=0.8
